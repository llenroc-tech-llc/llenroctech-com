# See https://docs.github.com/get-started/getting-started-with-git/ignoring-files

# ───────────────────────────────
# Node / Angular build outputs
# ───────────────────────────────
/dist
/tmp
/out-tsc
/bazel-out
/.angular/cache
Ovro/dist/
Ovro/.angular/
*.log

# ───────────────────────────────
# Dependencies
# ───────────────────────────────
/node_modules
Ovro/node_modules/
npm-debug.log
yarn-error.log

# ───────────────────────────────
# Netlify
# ───────────────────────────────
.netlify/
netlify/*.log

# ───────────────────────────────
# Environment files (DO NOT COMMIT SECRETS)
# ───────────────────────────────
.env
.env.*
env

# ───────────────────────────────
# IDEs / Editors
# ───────────────────────────────
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/*

# ───────────────────────────────
# Miscellaneous
# ───────────────────────────────
.sass-cache/
.connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# ───────────────────────────────
# OS junk
# ───────────────────────────────
.DS_Store
Thumbs.db
