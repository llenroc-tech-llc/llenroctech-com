# --- Node / Package managers ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json.gz

# --- OS / Editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

# --- Angular / Build outputs ---
dist/
out-tsc/
.angular/cache/
coverage/
*.log
.eslintcache

# Optional: Angular env files ONLY if they contain secrets (prefer moving secrets to env vars)
# Uncomment if you currently have secrets in these:
# src/environments/environment.ts
# src/environments/environment.prod.ts

# --- Netlify ---
# Site-local state created by Netlify CLI (contains site id, etc.)
.netlify/
# Netlify dev compiled functions output
.netlify/functions-serve/
# If you keep any local env files for Netlify/Functions
netlify/*.env
netlify/.env
netlify/functions/*.env
netlify/functions/.env

# --- Env files (DO NOT COMMIT SECRETS) ---
.env
.env.*
!.env.example             # commit a template only (no real secrets)
*.local.env
*.env.local
*.envrc

# --- Supabase (local dev) ---
supabase/.branches
supabase/.temp
supabase/.env
supabase/.env.local

# --- Stripe (local cache / CLI) ---
.stripe/
stripe.log

# --- Runtime keys cached anywhere ---
*.secret
*.secrets
*.key
*.pem
*.p12
*.pfx

# --- Framework/Tooling caches (optional but harmless to ignore) ---
.cache/
